<?xml version="1.0" encoding="utf-8"?>
<!-- 平板/横屏适配（sw600dp+）：操作按钮3个一行，说明板块改为2×2玻璃卡片 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DeviceResetSpoofer"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清除应用数据后自动生成全新设备识别码"
            android:textSize="13sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- 三个操作按钮同一行：运行日志 + 语言切换 + 检查更新 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btn_open_config"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 运行日志"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btn_switch_lang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌐 中/EN/RU"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔄 检查更新"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- 说明板块 2×2 网格：第1行 = 使用说明 | 工作原理 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- 使用说明 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="16dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/tv_usage_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📖 使用方法"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_usage_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#CCCCCC"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <!-- 工作原理 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="16dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/tv_principle_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔧 工作原理"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_principle_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#CCCCCC"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 说明板块 2×2 网格：第2行 = 伪装的识别码 | 注意事项 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 伪装的识别码 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="16dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/tv_spoof_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎭 伪装的识别码"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_spoof_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#CCCCCC"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <!-- 注意事项（红色调警告卡片） -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_warning"
                android:padding="16dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/tv_warning_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ 注意事项"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#EF5350"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_warning_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#CCCCCC"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
