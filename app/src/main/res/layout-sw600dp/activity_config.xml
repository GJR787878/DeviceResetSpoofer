<?xml version="1.0" encoding="utf-8"?>
<!-- 平板/横屏适配（sw600dp+）：伪装按钮改为2列网格，不再单列拉伸 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 生效范围：黑底白字，无背景 -->
        <TextView
            android:id="@+id/tv_scope_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ 生效范围"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_scope_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#CCCCCC"
            android:lineSpacingExtra="3dp"
            android:padding="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- 伪装选项标题：黑底白字，无背景 -->
        <TextView
            android:id="@+id/tv_spoof_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎭 伪装选项"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- 第1行：Android ID + 广告ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/btn_android_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="14dp"
                android:background="@drawable/bg_pill_glass"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/tv_android_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="伪装 Android ID"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_ad_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="14dp"
                android:background="@drawable/bg_pill_glass"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="6dp">
                <TextView
                    android:id="@+id/tv_ad_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="伪装 广告ID (AAID)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 第2行：IMEI + Build -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/btn_imei"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="14dp"
                android:background="@drawable/bg_pill_glass"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/tv_imei"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="伪装 IMEI/MEID"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_build"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="14dp"
                android:background="@drawable/bg_pill_glass"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="6dp">
                <TextView
                    android:id="@+id/tv_build"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="伪装 设备型号 (Build)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 第3行：MAC + GSF -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/btn_mac"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="14dp"
                android:background="@drawable/bg_pill_glass"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/tv_mac"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="伪装 MAC地址"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_gsf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="14dp"
                android:background="@drawable/bg_pill_glass"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="6dp">
                <TextView
                    android:id="@+id/tv_gsf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="伪装 GSF ID"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 第4行：运营商 + 显示当前伪装值 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/btn_carrier"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="14dp"
                android:background="@drawable/bg_pill_glass"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/tv_carrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="伪装 运营商信息"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_show_identity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="14dp"
                android:background="@drawable/bg_pill_glass"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="6dp">
                <TextView
                    android:id="@+id/tv_show_identity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="显示当前伪装值"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 底部提示：黑底白字，无背景 -->
        <TextView
            android:id="@+id/tv_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:gravity="center"
            android:lineSpacingExtra="2dp"/>

    </LinearLayout>
</ScrollView>
