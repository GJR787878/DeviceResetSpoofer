<?xml version="1.0" encoding="utf-8"?>
<!-- 警告玻璃卡片 - 红色调五层玻璃效果，12dp圆角 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 红色渐变描边 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#80FF5252"
                android:endColor="#26FF5252" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- 半透明深红填充 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#333B0E0E" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <!-- 顶部高光 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#33FF8A80"
                android:endColor="#00FF8A80" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <!-- 底部内阴影 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00000000"
                android:endColor="#33000000" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>
