<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 生效范围：黑底白字，无背景 -->
        <TextView
            android:id="@+id/tv_scope_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ 生效范围"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_scope_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#CCCCCC"
            android:lineSpacingExtra="3dp"
            android:padding="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- 伪装选项标题：黑底白字，无背景 -->
        <TextView
            android:id="@+id/tv_spoof_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎭 伪装选项"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- Android ID：胶囊按钮，点击切换，文字居中 -->
        <LinearLayout
            android:id="@+id/btn_android_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="14dp"
            android:background="@drawable/bg_pill_glass"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/tv_android_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="伪装 Android ID"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- 广告ID -->
        <LinearLayout
            android:id="@+id/btn_ad_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="14dp"
            android:background="@drawable/bg_pill_glass"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/tv_ad_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="伪装 广告ID (AAID)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- IMEI -->
        <LinearLayout
            android:id="@+id/btn_imei"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="14dp"
            android:background="@drawable/bg_pill_glass"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/tv_imei"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="伪装 IMEI/MEID"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Build -->
        <LinearLayout
            android:id="@+id/btn_build"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="14dp"
            android:background="@drawable/bg_pill_glass"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/tv_build"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="伪装 设备型号 (Build)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- MAC -->
        <LinearLayout
            android:id="@+id/btn_mac"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="14dp"
            android:background="@drawable/bg_pill_glass"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/tv_mac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="伪装 MAC地址"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- GSF -->
        <LinearLayout
            android:id="@+id/btn_gsf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="14dp"
            android:background="@drawable/bg_pill_glass"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/tv_gsf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="伪装 GSF ID"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- 运营商 -->
        <LinearLayout
            android:id="@+id/btn_carrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="14dp"
            android:background="@drawable/bg_pill_glass"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="20dp">
            <TextView
                android:id="@+id/tv_carrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="伪装 运营商信息"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- 显示当前伪装值按钮 -->
        <LinearLayout
            android:id="@+id/btn_show_identity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="14dp"
            android:background="@drawable/bg_pill_glass"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="20dp">
            <TextView
                android:id="@+id/tv_show_identity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="显示当前伪装值"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- 底部提示：黑底白字，无背景 -->
        <TextView
            android:id="@+id/tv_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:gravity="center"
            android:lineSpacingExtra="2dp"/>

    </LinearLayout>
</ScrollView>
