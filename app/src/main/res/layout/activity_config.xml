<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 说明卡片 -->
        <TextView
            android:id="@+id/tv_scope_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ 生效范围"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#B388FF"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_scope_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#CCCCDD"
            android:lineSpacingExtra="3dp"
            android:background="@drawable/bg_card_glass"
            android:alpha="0.9"
            android:padding="14dp"
            android:layout_marginBottom="20dp"/>

        <!-- 伪装开关标题 -->
        <TextView
            android:id="@+id/tv_spoof_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎭 伪装选项"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#B388FF"
            android:layout_marginBottom="12dp"/>

        <!-- Android ID开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card_glass"
            android:alpha="0.9"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/tv_android_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="伪装 Android ID"
                android:textSize="14sp"
                android:textColor="#E0E0FF"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_hook_android_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 广告ID开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card_glass"
            android:alpha="0.9"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/tv_ad_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="伪装 广告ID (AAID)"
                android:textSize="14sp"
                android:textColor="#E0E0FF"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_hook_ad_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- IMEI开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card_glass"
            android:alpha="0.9"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/tv_imei"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="伪装 IMEI/MEID"
                android:textSize="14sp"
                android:textColor="#E0E0FF"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_hook_imei"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Build开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card_glass"
            android:alpha="0.9"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/tv_build"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="伪装 设备型号 (Build)"
                android:textSize="14sp"
                android:textColor="#E0E0FF"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_hook_build"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- MAC开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card_glass"
            android:alpha="0.9"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/tv_mac"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="伪装 MAC地址"
                android:textSize="14sp"
                android:textColor="#E0E0FF"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_hook_mac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- GSF开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card_glass"
            android:alpha="0.9"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/tv_gsf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="伪装 GSF ID"
                android:textSize="14sp"
                android:textColor="#E0E0FF"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_hook_gsf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 运营商开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card_glass"
            android:alpha="0.9"
            android:layout_marginBottom="20dp">
            <TextView
                android:id="@+id/tv_carrier"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="伪装 运营商信息"
                android:textSize="14sp"
                android:textColor="#E0E0FF"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_hook_carrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 底部提示 -->
        <TextView
            android:id="@+id/tv_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#8888AA"
            android:gravity="center"
            android:lineSpacingExtra="2dp"/>

    </LinearLayout>
</ScrollView>
